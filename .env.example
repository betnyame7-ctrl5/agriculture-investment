# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Local and production HTTP port (default 3000)
PORT="3000"

# JWT_SECRET: Secret key for signing user sessions
JWT_SECRET="agro-invest-jwt-secure-secret-key-2026"

# (Optional) SMTP Configuration for Outgoing 5-Digit Verification Emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@agricultureinvestment.com"
SMTP_PASS="password"

# (Optional) Supabase Credentials (if switching to remote Supabase database)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
